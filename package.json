{
  "name": "scenesense",
  "version": "0.1.0",
  "private": true,
  "description": "SceneSense — a local OBS companion for clearer Twitch broadcasts",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run test && npm run build",
    "test:desktop": "npm run build && node scripts/smoke.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "bot-avatars": "^0.2.2",
    "gsap": "^3.15.0",
    "matter-js": "^0.20.0",
    "motion": "^14.9.0",
    "obs-websocket-js": "^5.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "thinking-orbs": "^0.3.2",
    "uiohook-napi": "^1.5.5",
    "vgpu": "0.4.1",
    "voice-glow": "^0.3.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^45.1.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
