# Add your keys here, then restart SceneSense.
OPENAI_API_KEY=
SARVAM_API_KEY=
# auto uses Sarvam when its key is present, otherwise OpenAI.
# OpenAI is still required for command interpretation.
VOICE_PROVIDER=auto
VOICE_LANGUAGE=en-IN

# Optional hosted judge access (no provider keys needed in this mode)
SCENESENSE_PROXY_URL=
SCENESENSE_JUDGE_CODE=
